FROM mirror.gcr.io/library/python:3.13-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock ./

RUN uv export --frozen --no-default-groups --group streamlit --no-dev --no-hashes -o /tmp/requirements.txt && \
    uv pip install --system -r /tmp/requirements.txt

COPY insightwellness_ai/ ./insightwellness_ai/

ENV PORT=8501

CMD streamlit run insightwellness_ai/dashboard/streamlit_app.py --server.port $PORT --server.address=0.0.0.0 --server.headless=true
